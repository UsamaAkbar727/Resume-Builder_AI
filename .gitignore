# Root-level gitignore to ignore build artifacts and dependencies in subfolders

# Root dependencies & build
node_modules/
.next/
tsconfig.tsbuildinfo

# Frontend subdirectory dependencies & builds
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/tsconfig.tsbuildinfo
frontend/next-env.d.ts

# Backend subdirectory dependencies & builds
backend/vendor/
backend/node_modules/
backend/public/build/
backend/public/hot/
backend/public/storage/
backend/.phpunit.cache/
backend/storage/*.key
backend/storage/pail

# System and IDE configuration
.DS_Store
Thumbs.db
.idea/
.vscode/
.zed/
.fleet/
.nova/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment and secrets
.env*
backend/.env
backend/.env.backup
backend/.env.production
frontend/.env*
auth.json

# Logs and tests
*.log
backend/npm-debug.log*
backend/yarn-debug.log*
backend/yarn-error.log*
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
backend/.phpunit.result.cache
